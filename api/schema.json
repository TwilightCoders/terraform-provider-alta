      "status": "ok",
      "note": "Passes through with ids and fields intact. Ports are accepted as number or string and kept as written.",
      "observed": "2026-09-14"
    },
    {
      "cloud": "site.firewall.firewall.rules[]",
      "device": "firewall.rules[] then firewall.@rule",
      "status": "ok",
