      "observed": "2026-09-14"
    },
    {
      "cloud": "site.vlans[]",
      "device": "interfaces[] bridge, services.dhcpServers[], firewall zone member, services.dnsForwarder.listenInterfaces",
      "status": "ok",
      "note": "Creating a VLAN also binds its bridge for DNS, so no local fix-up is needed for that.",
      "observed": "2026-09-14"
    },
    {
      "cloud": "site.vlans[].dnsServers",
      "device": "services.dhcpServers[].dnsServers",
      "status": "ok",
      "note": "Comma-joined string in the cloud, list on the device. This is the only input for the untagged LAN's DHCP DNS as well.",
      "observed": "2026-09-14"
    },
    {
      "cloud": "device.services.dhcpServers[].dnsServers",
      "device": "(nothing)",
      "status": "defect",
      "note": "Stored by the cloud and echoed back, but ignored by the compiler for the untagged LAN; the VLAN entry wins. Writing it looks successful and changes nothing.",
      "observed": "2026-09-14"
    },
    {
      "cloud": "device.jumboFrames",
      "device": "interfaces[].mtu",
      "status": "defect",
      "note": "Applied to bridges and most interface entries, but the trailing per-port entries emitted for ports carrying eee or speed overrides get no mtu key, and the last entry wins. Those ports fall back to 1500 on every push.",
      "observed": "2026-09-14"
    },
    {
      "cloud": "device.portsCfg.ports{}",
      "device": "bridge members and VLAN subinterfaces",
      "status": "ok",
      "note": "A port with allowedVlans.all tags every VLAN, including ones added later.",
      "observed": "2026-09-14"
    },
    {
      "cloud": "clients[].config.ip",
      "device": "services.dhcpServers[].staticMappings[]",
      "status": "ok",
      "note": "The matching VLAN is chosen by subnet. config.vlan is a separate client VLAN assignment, not part of the reservation.",
      "observed": "2026-09-14"
    },
    {
      "cloud": "site.routes[]",
      "device": "staticRoutes then network.@route",
      "status": "unverified",
      "note": "The cloud vocabulary is confirmed from the portal's own save path, which builds {id, name, type, network, nextHop, interface, metric}, drops empty fields, sends metric as a number, generates the id client-side as a 6-character nanoid, and rewrites the whole array sorted by metric then destination. The device generator reads staticRoutes and emits network.@route target/gateway/interface/type/metric/table/mtu. No route has been pushed and observed end to end yet, so static_route stays unobserved."
    }
