    },
    "note": "Alta Labs publishes no API description. Endpoints are extracted from the portal bundle above; object fields are fitted from captured responses by `make schema`; the compile mapping is observed on a router and dated. Treat every entry as evidence, not contract. Captures checked in as fixtures are anonymised and reduced to the fields the tests use; objects marked partial_capture are augmented from live reads rather than narrowed to the fixtures."
  },
  "endpoints": [
    {
      "name": "site",
      "method": "GET",
      "path": "/api/site",
      "token": "header",
      "semantics": "Reads the site document: firewall (nat and filter rules), vlans, routes, wans and site-wide settings."
    },
    {
      "name": "site_state",
      "method": "GET",
      "path": "/api/site/state",
      "token": "header",
      "semantics": "Reads live devices and clients. Device records carry portsCfg and services; client records carry config, including a fixed IP."
    },
    {
      "name": "site_audit",
      "method": "GET",
      "path": "/api/site/audit",
      "token": "header",
      "semantics": "Reads the change trail, including the portal user behind each change and firmware updates as edit/dev entries."
    },
    {
      "name": "site_edit",
      "method": "POST",
      "path": "/api/site",
      "token": "body",
      "semantics": "Replaces one top-level site key wholesale, e.g. {id, vlans}. There is no per-field update and no version field: the last writer wins on the key."
    },
    {
      "name": "device_edit",
      "method": "POST",
      "path": "/api/device/edit",
      "token": "body",
      "semantics": "Replaces one device field wholesale, e.g. {id, portsCfg}."
    },
    {
      "name": "client_edit",
      "method": "POST",
      "path": "/api/client/edit",
      "token": "body",
      "semantics": "Sets client record fields flat, e.g. {siteid, id, ip, vlan}. Stored back under the record's config object."
    },
    {
      "name": "wifi_ssid_list",
      "method": "POST",
      "path": "/api/wifi/ssid/list",
      "token": "header",
      "semantics": "Lists a site's wireless networks. Not yet exercised: an SSID is its own object with its own create, edit and delete endpoints, so unlike the site document's collections it is not written by whole-key replacement."
    },
    {
      "name": "wifi_ssid",
      "method": "POST",
      "path": "/api/wifi/ssid",
      "token": "header",
      "semantics": "Creates or edits one wireless network, as {token, config}. Not yet exercised. The portal sends the whole object and explicitly nulls every field left unset, so a partial write is a replacement rather than a merge."
    },
    {
      "name": "wifi_ssid_delete",
      "method": "POST",
      "path": "/api/wifi/ssid/delete",
      "token": "header",
      "semantics": "Deletes one wireless network. Not yet exercised."
    }
  ],
